generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customers Customer[]
  leads     Lead[]
  deals     Deal[]
  accounts  Account[]
  journalEntries JournalEntry[]
  invoices  Invoice[]
  payments  Payment[]
  expenses  Expense[]
  licenses  UserLicense[]

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  leads     Lead[]
  deals     Deal[]
  invoices  Invoice[]

  @@map("customers")
}

model Lead {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("NEW")
  source      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  customerId  String?  @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@map("leads")
}

model Deal {
  id          String   @id @default(cuid())
  title       String
  value       Float?
  status      String   @default("PENDING")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  customerId  String?  @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@map("deals")
}

model Account {
  id          String   @id @default(cuid())
  code        String
  name        String
  type        String
  parentId    String?  @map("parent_id")
  parent      Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[] @relation("AccountHierarchy")
  description String?
  balance     Float    @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  debitLines  JournalEntryLine[] @relation("DebitAccount")
  creditLines JournalEntryLine[] @relation("CreditAccount")

  @@unique([code, userId])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(cuid())
  date        DateTime
  reference   String?
  description String?
  totalDebit  Float    @map("total_debit")
  totalCredit Float    @map("total_credit")
  isPosted    Boolean  @default(false) @map("is_posted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  lines       JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id       String  @id @default(cuid())
  debit    Float   @default(0)
  credit   Float   @default(0)
  description String?

  entryId  String @map("entry_id")
  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  debitAccountId   String? @map("debit_account_id")
  debitAccount     Account? @relation("DebitAccount", fields: [debitAccountId], references: [id])

  creditAccountId  String? @map("credit_account_id")
  creditAccount    Account? @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@map("journal_entry_lines")
}

model Invoice {
  id          String   @id @default(cuid())
  number      String
  issueDate   DateTime @map("issue_date")
  dueDate     DateTime @map("due_date")
  subtotal    Float
  taxRate     Float    @default(15) @map("tax_rate")
  taxAmount   Float    @map("tax_amount")
  total       Float
  status      String   @default("DRAFT")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id])

  items       InvoiceItem[]
  payments    Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float   @map("unit_price")
  total       Float

  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Float
  method      String   @default("CASH")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  invoiceId   String?  @map("invoice_id")
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Float
  category    String
  description String?
  receiptUrl  String?  @map("receipt_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  @@map("expenses")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   String?  @map("old_data")
  newData   String?  @map("new_data")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model SystemModule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  price       Float    @default(0)
  isCore      Boolean  @default(false) @map("is_core")
  createdAt   DateTime @default(now()) @map("created_at")

  licenses    UserLicense[]

  @@map("system_modules")
}

model UserLicense {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  moduleId  String    @map("module_id")
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User         @relation(fields: [userId], references: [id])
  module    SystemModule @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@map("user_licenses")
}
